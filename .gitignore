.DS_Store
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
/dist/
# your own settings and keys never get committed
.env
.env.*
!.env.example
*.key
*.pem
kits/*/config.json
# A kit's doctor.json may name another settings file (config_file), which lives at the
# top of the kit folder. Every JSON file there is local settings except the tracked
# doctor.json and *.example.json files.
kits/*/*.json
!kits/*/doctor.json
!kits/*/*.example.json
